# C1RCLE Partner Dashboard
#
# Copy to .env.local and fill in. Every variable here is declared in
# packages/config/src/schema.ts and validated at startup — a missing or
# malformed value fails the build rather than producing a broken page.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Never put a secret
# in one. This repository holds no secrets at all.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME="C1RCLE Partner Dashboard"
NEXT_PUBLIC_ENVIRONMENT=development

# Optional
# NEXT_PUBLIC_SENTRY_DSN=

# GCP Identity Platform (Firebase Auth) — only used by the onboarding
# wizard's phone-verification step. Same GCP project as the backend's
# FIREBASE_PROJECT_ID; these are the project's public web-app config values
# (not secrets — get them from Firebase console > Project settings > Your
# apps > Web app > SDK setup and configuration).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_API_BASE_URL=https://circle-v2-backend.onrender.com
EXPO_PUBLIC_ENV=staging

# The venue this handset scans for, sent as X-Organization-Id on every call.
# Set this and the login screen matches the design exactly (staff ID + password);
# leave it blank and login shows a one-time venue-ID field instead.
EXPO_PUBLIC_ORGANIZATION_ID=

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "//": "3 apps + 9 package watchers = 12 persistent dev tasks; the default cap of 10 rejects the graph.",
  "concurrency": "15",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "turbo.json",
    "prettier.config.mjs",
    "tsconfig.json"
  ],
  "globalEnv": ["NODE_ENV", "CI", "ANALYZE", "C1RCLE_STANDALONE", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": ["VERCEL", "VERCEL_ENV", "VERCEL_URL", "TURBO_TOKEN", "TURBO_TEAM"],
  "remoteCache": {
    "enabled": true,
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.test.tsx", "!**/*.md"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "clean": {
      "cache": false
    }
  }
}

{
  "name": "@c1rcle/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    },
    "./guest-onboarding": {
      "import": {
        "types": "./dist/contracts/guest-onboarding.d.ts",
        "default": "./dist/contracts/guest-onboarding.js"
      },
      "require": {
        "types": "./dist/contracts/guest-onboarding.d.ts",
        "default": "./dist/contracts/guest-onboarding.js"
      }
    },
    "./guest-social": {
      "import": {
        "types": "./dist/contracts/guest-social.d.ts",
        "default": "./dist/contracts/guest-social.js"
      },
      "require": {
        "types": "./dist/contracts/guest-social.d.ts",
        "default": "./dist/contracts/guest-social.js"
      }
    },
    "./saved-events": {
      "types": "./dist/contracts/saved-events.d.ts",
      "import": "./dist/contracts/saved-events.js",
      "require": "./dist/contracts/saved-events.js"
    },
    "./partner-marketing": {
      "types": "./src/contracts/partner-marketing.ts",
      "import": "./src/contracts/partner-marketing.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@c1rcle/eslint-config": "workspace:*",
    "@c1rcle/tsconfig": "workspace:*",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}

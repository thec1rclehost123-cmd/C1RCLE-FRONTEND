{
  "name": "c1rcle-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "C1RCLE Web Platform \u2014 modular monorepo for all frontend applications.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "pnpm --filter @c1rcle/scripts run check-boundaries",
    "clean": "turbo run clean",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@c1rcle/eslint-config": "workspace:*",
    "@c1rcle/tsconfig": "workspace:*",
    "@eslint/js": "9.39.1",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0"
  },
  "pnpm": {
    "overrides": {
      "lucide-react": "1.28.0",
      "@grpc/grpc-js": ">=1.14.5",
      "brace-expansion@<2": "1.1.21",
      "brace-expansion@>=2 <6": "5.0.12",
      "js-yaml": ">=4.3.2",
      "nanoid@^3.0.0": "3.3.18",
      "postcss-selector-parser@^6.0.0": ">=6.1.5 <7",
      "re2js": ">=2.8.7",
      "source-map-js": ">=1.2.2",
      "undici@^7.0.0": ">=7.30.1 <8",
      "uuid@<11": "11.1.1",
      "vite@>=8.2.0 <8.3.0": "8.2.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
